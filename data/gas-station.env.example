# Copy this file to gas-station.env in the same folder.
# That file is blocked from the web and is not committed.
# Use independent hot-wallet keys. Never put the merchant vault key on the server.
# Values are 32-byte (64 hexadecimal character) private keys/seeds.
GAS_STATION_PRIVATE_KEY=0xYOUR_GAS_STATION_PRIVATE_KEY
GAS_STATION_TRON_PRIVATE_KEY=0xYOUR_TRON_PRIVATE_KEY
GAS_STATION_SOL_SEED=0xYOUR_SOLANA_ED25519_SEED
GAS_STATION_TON_SEED=0xYOUR_TON_ED25519_SEED
GAS_STATION_APT_SEED=0xYOUR_APTOS_ED25519_SEED
GAS_STATION_NEAR_SEED=0xYOUR_NEAR_ED25519_SEED
GAS_STATION_DOT_SEED=0xYOUR_POLKADOT_ED25519_SEED
